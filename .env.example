# Copy to .env and fill in. Never commit .env.
# Which model ask()/ask_json()/ask_image() use: anthropic or gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Gemini free tier: key from aistudio.google.com. Free tier may use prompts to improve Google products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CALENDAR_ID=primary
TIMEZONE=America/Los_Angeles
# OCR words below this confidence (0-100) count as "unclear"
OCR_MIN_CONF=80
SLACK_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Limited Twilio trial: only fixed templates can be sent, e.g. sms_appointment_reminders (empty on paid accounts)
TWILIO_TRIAL_TEMPLATE=
# Google Sheet published as CSV; empty = data/crm_leads.csv
CRM_CSV_URL=

# ---- Clio (READ-ONLY developer app; never give it write permission)
CLIO_BASE=https://app.clio.com
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://127.0.0.1:8765/callback
CLIO_ACCESS_TOKEN=
CLIO_REFRESH_TOKEN=
# Text used to find the demo matter by search (not a hardcoded id)
CLIO_MATTER_QUERY=Sapini
# ---- Our own storage (outside Clio)
DB_PATH=data/lawmonade.db
SNAPSHOT_DIR=data/matters
# Signs provider share links. Make one: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SHARE_LINK_SECRET=
SHARE_LINK_DAYS=14
# Demo mode: sample case file from the organizers (kept outside git). Empty = default path next to this folder.
# DEMO_FILE=/Users/you/Documents/Applied AI Hackathon/Slides & Materials - Shared w- Participants/Sapini Case Materials/sapini-clio-data.json
# Base address of share links (change if you put the app online, e.g. with ngrok)
PUBLIC_URL=http://localhost:8501
# Firm name shown in the app and to providers (fictional for the demo)
FIRM_NAME=Brightwater & Vance Injury Law

# ---- Email to providers. Default: Gmail sign-in once with: bash run.sh gmail
EMAIL_FROM=
# Demo safety: every email goes to this address instead (sample contacts have fake .test addresses)
EMAIL_DEMO_REDIRECT=
# Or use SMTP instead of Gmail sign-in (Gmail: use an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
