{
  "name": "PI Docket: weekday 8am digest -> Slack",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * 1-5" }] }
      },
      "id": "b1b2c3d4-0001-4000-8000-000000000001",
      "name": "Every weekday 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/deadlines",
        "options": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000002",
      "name": "Get deadlines",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const start = new Date(new Date().toDateString());\nconst end = new Date(start.getTime() + 7 * 864e5);\nconst due = $input.all().map(i => i.json).filter(d => d.due_date && new Date(d.due_date) >= start && new Date(d.due_date) <= end);\nconst lines = due.map(d => `• ${d.due_date}  ${d.title}  (${d.case_label || 'no case'})`);\nreturn [{ json: { text: lines.length ? `Due in the next 7 days:\\n${lines.join('\\n')}` : 'Nothing due in the next 7 days.' } }];"
      },
      "id": "b1b2c3d4-0003-4000-8000-000000000003",
      "name": "Next 7 days",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/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",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {}
      },
      "id": "b1b2c3d4-0004-4000-8000-000000000004",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Every weekday 8am": { "main": [[{ "node": "Get deadlines", "type": "main", "index": 0 }]] },
    "Get deadlines": { "main": [[{ "node": "Next 7 days", "type": "main", "index": 0 }]] },
    "Next 7 days": { "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]] }
  },
  "settings": {}
}
